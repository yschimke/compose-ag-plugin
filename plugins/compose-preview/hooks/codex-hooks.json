{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-summary.sh\" --harness=codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/stop-gate.sh\" --harness=codex",
            "timeout": 360,
            "type": "command"
          }
        ]
      }
    ]
  }
}
