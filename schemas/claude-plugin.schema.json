{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude Code and Codex plugin manifest (vendored minimal contract)",
  "type": "object",
  "required": ["name", "version", "description", "author", "repository", "license", "keywords"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "author": {"type": "object", "required": ["name"]},
    "repository": {"type": "string"},
    "license": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
