{
  "repository": "https://github.com/yschimke/compose-ag-plugin",
  "license": "Apache-2.0",
  "owner": "Yuri Schimke",
  "plugins": [
    {
      "name": "compose-catalogs",
      "version": "0.2.0",
      "description": "Discover Compose components, inspect properties, and render catalog variants.",
      "keywords": [
        "compose",
        "catalog",
        "material3",
        "wear"
      ],
      "interface": {
        "displayName": "Compose Catalogs",
        "shortDescription": "Discover and render Compose component catalogs.",
        "longDescription": "Discover Compose components, inspect their properties, and render catalog variants through Compose Preview.",
        "developerName": "Yuri Schimke",
        "category": "Developer Tools",
        "capabilities": [
          "Interactive"
        ],
        "defaultPrompt": [
          "Show the available Compose component catalogs."
        ]
      },
      "mcp": [
        {
          "name": "compose-preview-catalog",
          "kind": "http",
          "url": "https://preview.coo.ee/mcp",
          "headers": {
            "X-Compose-Preview-Token": "${COMPOSE_PREVIEW_TOKEN:-}"
          },
          "codexEnvHeaders": {
            "X-Compose-Preview-Token": "COMPOSE_PREVIEW_TOKEN"
          }
        }
      ],
      "skills": [
        "harness-notes"
      ],
      "agents": [
        "design-reviewer"
      ]
    },
    {
      "name": "compose-preview",
      "version": "0.2.0",
      "description": "Iterate on local Compose previews with live rendering and accessibility checks.",
      "keywords": [
        "compose",
        "preview",
        "accessibility",
        "android"
      ],
      "interface": {
        "displayName": "Compose Preview",
        "shortDescription": "Render and review Compose previews.",
        "longDescription": "Iterate on local Compose previews with live rendering, accessibility checks, and shared review evidence.",
        "developerName": "Yuri Schimke",
        "category": "Developer Tools",
        "capabilities": [
          "Interactive"
        ],
        "defaultPrompt": [
          "Render and review the Compose previews in this project."
        ]
      },
      "mcp": [
        {
          "name": "compose-preview-mcp",
          "kind": "stdio",
          "command": "compose-preview",
          "args": [
            "mcp",
            "serve"
          ]
        }
      ],
      "skills": [
        "harness-notes",
        "antigravity-viewer-card"
      ],
      "agents": [
        "design-reviewer"
      ],
      "assets": [
        "compose-preview-viewer.html",
        "compose-preview-card.py",
        "compose-preview-viewer-fallback.md",
        "compose-preview-viewer.provenance.json"
      ],
      "hooks": [
        {
          "event": "SessionStart",
          "command": "scripts/session-start-summary.sh",
          "matcher": "startup",
          "timeout": 10
        },
        {
          "event": "Stop",
          "command": "scripts/stop-gate.sh",
          "timeout": 360
        }
      ]
    }
  ]
}
